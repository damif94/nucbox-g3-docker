# Rendered by the nginx image entrypoint: only ${OPENFIGI_API_KEY} is substituted,
# nginx's own $variables are left alone (no env var shares their names).

# OpenFIGI's anonymous limit is 25 requests/min for the whole key/IP, so limit globally
# (behind NPM every request comes from the proxy's IP anyway).
limit_req_zone $server_name zone=figi:1m rate=20r/m;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;

  # Everything except the healthcheck sits behind basic auth (keeps the OpenFIGI proxy private).
  # The file is written at startup by deploy/10-htpasswd.sh from PORTFOLIO_USER/PORTFOLIO_PASSWORD.
  auth_basic "Portfolio";
  auth_basic_user_file /etc/nginx/conf.d/htpasswd;

  location = /healthz {
    auth_basic off;
    access_log off;
    return 200 'ok';
  }

  # Thin proxy to OpenFIGI: only security identifiers ever pass through here.
  location = /api/figi {
    limit_except POST { deny all; }
    limit_req zone=figi burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 16k;

    resolver 127.0.0.11 1.1.1.1 valid=300s ipv6=off;
    set $openfigi https://api.openfigi.com/v3/mapping;
    proxy_pass $openfigi;
    proxy_ssl_server_name on;
    proxy_set_header Host api.openfigi.com;
    proxy_set_header Content-Type application/json;
    # an empty value means the header is not sent (anonymous tier)
    proxy_set_header X-OPENFIGI-APIKEY "${OPENFIGI_API_KEY}";
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    add_header Cache-Control no-store always;
  }

  # The last uploaded CSV set (see src/lib/store.ts), shared by every login. Only these five
  # names can be read or written. WebDAV PUT writes to a temp file on the same volume and
  # renames it into place, so a reader never sees a half-written file.
  location ~ ^/api/data/((accounts|positions|assets|activity)\.csv|meta\.json)$ {
    limit_except GET PUT { deny all; }
    alias /data/$1;
    dav_methods PUT;
    dav_access user:rw;
    client_max_body_size 25m;
    client_body_temp_path /data/.tmp;
    add_header Cache-Control no-store always;
    add_header X-Content-Type-Options nosniff always;
  }

  # nothing else under /api/ (keeps it out of the SPA fallback)
  location /api/ {
    return 404;
  }

  # hashed bundles never change
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control no-cache;
    try_files $uri /index.html;
  }
}
