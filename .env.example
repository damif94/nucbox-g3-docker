TZ=America/Montevideo
TIMEZONE=America/Montevideo

# Nginx Proxy Manager — MariaDB
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=npm
MYSQL_USER=npm
MYSQL_PASSWORD=changeme

# n8n
N8N_HOST=n8n.damianferencz.org
N8N_WEBHOOK_URL=https://n8n.damianferencz.org/
N8N_EDITOR_BASE_URL=https://n8n.damianferencz.org/
N8N_ENCRYPTION_KEY=changeme
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme

# Evolution API
EVOLUTION_SERVER_URL=https://evolution.damianferencz.org
EVOLUTION_API_KEY=changeme
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=changeme

# Shared PostgreSQL server
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme

# Example: per-service DB block (duplicate for each service that uses shared postgres)
# EXAMPLE_DB_USER=example
# EXAMPLE_DB_PASSWORD=changeme
# EXAMPLE_DB_NAME=example

# Cloudflare DDNS — API token with DNS:Edit permission for damianferencz.org
CF_API_TOKEN=changeme

# MCP Gateway
N8N_MCP_API_KEY=changeme

# Google Drive MCP — comma-separated account names
# Each account needs a token.json at mcp/credentials/<name>/token.json
# Run mcp/scripts/google_auth.py on your local machine to generate tokens
# Example: GOOGLE_ACCOUNTS=personal,work
GOOGLE_ACCOUNTS=

# Watchtower — Telegram notifications
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme

# Agents (agents.damianferencz.org) — custom AI agent host
ANTHROPIC_API_KEY=changeme
# Client auth for /chat — send as `X-API-Key` header. Leave empty to disable auth.
AGENTS_API_KEY=changeme
# MCP gateway bearer token (must match a token in mcp/nginx.conf) — bare token, no "Bearer " prefix.
# Lets a customer's agent reach https://mcp.damianferencz.org/<integration> via the MCP connector.
MCP_GATEWAY_TOKEN=changeme

# Maximus tool pack (read-only MaximUS API wrapper, used by the `maximus` customer).
# MAXIMUS_API_TOKEN is sent verbatim as the Authorization header — if the API needs
# a "Bearer " prefix, include it here (the MaximUS spec documents a bare token).
MAXIMUS_API_TOKEN=changeme
# MAXIMUS_BASE_URL=https://apimax.picodix.com
