TZ=America/Montevideo
TIMEZONE=America/Montevideo

# Nginx Proxy Manager — MariaDB
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=npm
MYSQL_USER=npm
MYSQL_PASSWORD=changeme

# n8n
N8N_HOST=n8n.damianferencz.org
N8N_WEBHOOK_URL=https://n8n.damianferencz.org/
N8N_EDITOR_BASE_URL=https://n8n.damianferencz.org/
N8N_ENCRYPTION_KEY=changeme
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme

# Evolution API
EVOLUTION_SERVER_URL=https://evolution.damianferencz.org
EVOLUTION_API_KEY=changeme
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=changeme

# Shared PostgreSQL server
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme

# Example: per-service DB block (duplicate for each service that uses shared postgres)
# EXAMPLE_DB_USER=example
# EXAMPLE_DB_PASSWORD=changeme
# EXAMPLE_DB_NAME=example

# Cloudflare DDNS — API token with DNS:Edit permission for damianferencz.org
CF_API_TOKEN=changeme

# MCP Gateway
N8N_MCP_API_KEY=changeme

# Google Drive MCP — comma-separated account names
# Each account needs a token.json at mcp/credentials/<name>/token.json
# Run mcp/scripts/google_auth.py on your local machine to generate tokens
# Example: GOOGLE_ACCOUNTS=personal,work
GOOGLE_ACCOUNTS=

# Watchtower — Telegram notifications
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme

# WireGuard (wg-easy) — public hostname clients dial in to
WG_HOST=vpn.damianferencz.org

# Anthropic API key — used by Hermes
ANTHROPIC_API_KEY=changeme
# MCP gateway bearer token (must match a token in mcp/nginx.conf) — bare token, no "Bearer " prefix.
MCP_GATEWAY_TOKEN=changeme


# Samba (Toshiba SMB share)
SAMBA_USER=damian
SAMBA_PASSWORD=changeme

# Ateneo Medico
ATENEO_DB_PASSWORD=changeme
ATENEO_SECRET_KEY=changeme
ATENEO_MENSAJES_TABLE_ID=YzVnRoMfnxuehsWP
ATENEO_TOKEN_EXPIRE=60

# Paywall → PDF Telegram bot
# Both are optional: falls back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID above.
# Set PAYWALL_BOT_TOKEN only if you want a bot separate from the shared one.
# PAYWALL_BOT_TOKEN=changeme
# PAYWALL_ALLOWED_CHAT_IDS=123456789,987654321
# Default PDF page size: iphone, a4, a5, a6, letter, legal
# (per-request override in chat: /pdf a4 <link>)
# PAYWALL_PDF_PAGE=iphone
# Output for a bare link: pdf (default) or epub — /epub and /pdf override it.
# PAYWALL_DEFAULT_FORMAT=pdf

# Portfolio dashboard — optional OpenFIGI key (empty = anonymous tier: 10 jobs/request, 25 req/min)
OPENFIGI_API_KEY=
# Logins for damianferencz.org/portfolio/ (required)
PORTFOLIO_USER=damian
PORTFOLIO_PASSWORD=
# Optional extra logins: user:password,user2:password2
PORTFOLIO_EXTRA_USERS=

# Edifica (damianferencz.org/edifica) — database on the shared postgres
EDIFICA_DB_USER=edifica
EDIFICA_DB_PASSWORD=          # openssl rand -hex 24 (URL-safe: it goes into the DB URL)
EDIFICA_DB_NAME=edifica
EDIFICA_JWT_SECRET=           # openssl rand -hex 32
# Superadmin seeded on first start (password >= 12 chars)
EDIFICA_SUPERADMIN_EMAIL=
EDIFICA_SUPERADMIN_PASSWORD=

# Hermes Agent (personal assistant on Telegram) — reuses ANTHROPIC_API_KEY above
# Dedicated bot from @BotFather; never share it with an n8n Telegram trigger (webhooks block polling)
HERMES_TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to it; everyone else is ignored
HERMES_TELEGRAM_ALLOWED_USERS=
# Login for the dashboard at http://192.168.0.100:9119 (LAN/VPN only)
HERMES_DASHBOARD_USER=damian
HERMES_DASHBOARD_PASSWORD=     # openssl rand -base64 18
HERMES_DASHBOARD_SECRET=       # openssl rand -hex 32 — keeps dashboard sessions across restarts
